{
	"name": "opendot",
	"productName": "OpenDot",
	"version": "0.1.0",
	"description": "Open-source team of AI agents (Dots) for your desktop (macOS and Windows), built on pi.",
	"license": "MIT",
	"type": "module",
	"main": "./out/main/index.js",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"e2e": "npm run build && playwright test",
		"dist:mac": "npm run build && electron-builder --mac --arm64 --x64 --publish never",
		"dist:mac:arm64": "npm run build && electron-builder --mac --arm64 --publish never",
		"dist:mac:x64": "npm run build && electron-builder --mac --x64 --publish never",
		"dist:win": "npm run build && electron-builder --win --x64 --publish never",
		"postinstall": "node scripts/check-node-version.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.0.2",
		"@earendil-works/pi-coding-agent": "1.0.2",
		"@earendil-works/pi-mcp": "1.0.2",
		"compromise": "14.17.0",
		"electron-log": "5.4.4",
		"fix-path": "5.0.0",
		"libphonenumber-js": "1.13.14",
		"nanoid": "6.0.1",
		"typebox": "1.3.27",
		"write-file-atomic": "8.0.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@fontsource-variable/inter": "5.3.0",
		"@playwright/test": "1.63.0",
		"@radix-ui/react-dialog": "1.1.23",
		"@radix-ui/react-dropdown-menu": "2.1.24",
		"@radix-ui/react-popover": "1.1.23",
		"@radix-ui/react-scroll-area": "1.2.18",
		"@radix-ui/react-select": "2.3.7",
		"@radix-ui/react-slider": "1.4.7",
		"@radix-ui/react-switch": "1.3.7",
		"@radix-ui/react-tabs": "1.1.21",
		"@radix-ui/react-tooltip": "1.2.16",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/react": "16.3.3",
		"@types/node": "22.20.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/write-file-atomic": "4.0.3",
		"@vitejs/plugin-react": "5.2.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"date-fns": "4.4.0",
		"electron": "44.5.1",
		"electron-builder": "26.15.3",
		"electron-vite": "5.0.0",
		"jsdom": "30.1.1",
		"lucide-react": "1.52.0",
		"motion": "14.0.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"react-virtuoso": "4.18.16",
		"rehype-highlight": "7.0.2",
		"remark-gfm": "4.0.1",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vite": "7.3.6",
		"vitest": "4.1.11",
		"zustand": "5.0.15"
	},
	"author": {
		"name": "OpenDot contributors"
	},
	"homepage": "https://opendot.live",
	"repository": {
		"type": "git",
		"url": "https://github.com/athulsreekumar/opendot.git",
		"directory": "desktop"
	},
	"bugs": "https://github.com/athulsreekumar/opendot/issues",
	"allowScripts": {
		"esbuild@0.28.2": true,
		"esbuild@0.25.12": true,
		"protobufjs@7.6.6": true,
		"electron-winstaller": false,
		"@google/genai": false
	}
}
