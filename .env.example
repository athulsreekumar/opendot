# Copy to .env.local for local development. Set the same names in Vercel → Project → Settings → Environment Variables.
SITE_URL=https://opendot.live

# Resend (https://resend.com) — API key with "Sending access" + contacts.
RESEND_API_KEY=
# The Resend Audience/segment that stores signups (leave empty to only email).
RESEND_AUDIENCE_ID=
# Where signup notifications go (your inbox).
EARLY_ACCESS_NOTIFY_TO=
# Sender. Until opendot.live is verified in Resend, keep onboarding@resend.dev (it can only email the account owner).
EARLY_ACCESS_FROM=OpenDot <onboarding@resend.dev>
# Optional: once the domain is verified, send signups a confirmation from this address.
EARLY_ACCESS_CONFIRM_FROM=

# Optional rate limiting with Upstash Redis (falls back to in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tests only: skip Resend calls.
RESEND_MOCK=

# SEO: search engine ownership verification. Each is only emitted as a <meta> tag when set.
# Google Search Console: the content value of the google-site-verification meta tag.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools: the content value of the msvalidate.01 meta tag.
BING_SITE_VERIFICATION=
# Yandex Webmaster: the content value of the yandex-verification meta tag.
YANDEX_VERIFICATION=
# Set automatically by Vercel. Anything other than "production" is served with noindex.
# VERCEL_ENV=production
